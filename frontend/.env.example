# Base URL of the backend API
VITE_API_URL="http://localhost:4000/api/v1"

# Basemap tiles for the network map. Left blank on purpose: pointing this at a public tile
# service would send the coordinates of NCA's masts to a third party, which Q5 rules out.
# Set it to NCA's own tile server, e.g. "https://tiles.nca.local/{z}/{x}/{y}.png".
VITE_MAP_TILE_URL=""
VITE_MAP_TILE_ATTRIBUTION=""
