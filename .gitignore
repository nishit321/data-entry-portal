# Dependencies
node_modules/

# Build output
dist/
build/
# deploy/release.sh builds the site beside the live one and swaps it in, keeping one
# previous build for a quick manual rollback. Both are build output like dist/ itself,
# and untracked they would trip the deployment's own clean-tree check.
dist.new/
dist.prev/

# Test artefacts
coverage/
test-results/
playwright-report/
blob-report/

# Runtime data — uploaded attachments and database backups hold real filings.
storage/
backups/

# Environment — never commit real secrets; .env.example is the tracked template.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Project documentation is maintained outside this repository.
docs/
ref-doc/

# Local agent and editor session config
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db
