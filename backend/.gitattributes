# Line endings are LF in the repository and in the working tree, on every OS.
# Prettier is configured with endOfLine: "lf", so a CRLF checkout on Windows
# would make `npm run format:check` fail on files nobody has touched.
* text=auto eol=lf

# Keep Git out of these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and mark as such in language stats.
package-lock.json linguist-generated=true -diff
