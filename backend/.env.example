# ============================================================================
# Backend environment variables. Copy to `.env` and adjust.
# Validated on startup (src/config/env.validation.ts) - the app will not boot
# if a required value is missing or malformed.
# ============================================================================

# --- Runtime ---
NODE_ENV="development"
PORT=4000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:5173"

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nca_portal?schema=public"

# --- JWT --- (JWT_SECRET must be at least 16 chars; use a long random string)
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN="1d"

# --- Password reset ---
FRONTEND_RESET_URL="http://localhost:5173/reset-password"
RESET_TOKEN_TTL_MIN=30

# --- Email (SendGrid) ---
# Leave SENDGRID_API_KEY empty in local demo: reset/welcome emails are printed
# to the backend console instead of being sent.
SENDGRID_API_KEY=""
# MAIL_FROM MUST be an address verified in SendGrid, otherwise sends fail with
# "403 - The from address does not match a verified Sender Identity".
# Demo: SendGrid > Settings > Sender Authentication > Single Sender Verification,
# verify an email you own, then put that exact address here.
# Production: authenticate the nca.gov.ss domain, then no-reply@nca.gov.ss works.
MAIL_FROM="verified-sender@example.com"
MAIL_FROM_NAME="NCA Data Collection Portal"
# Login link used in welcome emails
FRONTEND_LOGIN_URL="http://localhost:5173/login"

# --- Rate limiting (global default; auth endpoints are stricter in code) ---
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=100

# --- MFA / OTP / account lockout ---
# MFA_ENABLED=true means login returns an OTP challenge; the token is issued only
# after /auth/verify-otp. No SMS provider yet, so the OTP is a fixed demo code
# (OTP_STATIC_CODE) logged to the backend console. Swap in a real gateway later.
MFA_ENABLED=true
OTP_STATIC_CODE=123456
OTP_TTL_MIN=5
# Echoes the one-time code in the login response. Demo only, so a walkthrough needs no inbox.
# It hands the second factor to whoever asked for the first, so never enable it where MFA matters.
OTP_ECHO_IN_RESPONSE=false
# Lock an account after this many consecutive failed passwords, for this long.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- File storage (submission attachments: coverage/fibre maps, agent registers) ---
# Blobs are written under STORAGE_DIR (relative to the backend working directory) and
# referenced by an opaque key in the database. Swap in an object store (S3) later by
# replacing StorageService. MAX_FILE_MB is the per-file upload limit.
STORAGE_DIR="storage"
MAX_FILE_MB=25

# --- Background jobs ---
# The compliance sweep, the document expiry sweep, and the notification email retry run on a
# timer. All three are idempotent, so a repeat run is harmless, but prefer running them on ONE
# instance: set SCHEDULER_ENABLED=false on the others so the work is not done twice.
# Cron is standard five-field: minute hour day month weekday. Times are the server's local zone.
SCHEDULER_ENABLED=true
COMPLIANCE_SWEEP_CRON="0 2 * * *"
DOCUMENT_EXPIRY_CRON="30 2 * * *"
NOTIFICATION_RETRY_CRON="15 * * * *"
# Accrues the daily part of any penalty and closes cases whose missing return has arrived.
PENALTY_ACCRUAL_CRON="45 2 * * *"
# Checks hourly whether any scheduled report is due to go out.
SCHEDULED_REPORTS_CRON="5 * * * *"
# Clears spent machine-API request nonces once their signature window has closed.
NONCE_SWEEP_CRON="20,50 * * * *"
# Pulls any network feed whose collection window has come round.
NETWORK_FEEDS_CRON="10 * * * *"

# --- Machine-to-machine API (Q10) ---
# Header a trusted TLS-terminating proxy uses to pass the client certificate fingerprint.
# Blank means the header is not read at all. Set it ONLY when a proxy in front of this app
# terminates TLS, and only when that proxy strips the header from inbound requests --
# otherwise any caller could claim any certificate by setting it themselves.
MACHINE_CLIENT_CERT_HEADER=""
MACHINE_NONCE_RETENTION_MINUTES="15"

# --- Seed admin (created by `npm run prisma:seed`) ---
SEED_ADMIN_EMAIL="admin@nca.gov.ss"
SEED_ADMIN_PASSWORD="Admin@12345"

# How many proxies sit in front of the app. Express counts back this many hops to find the caller's
# real address, which is what rate limiting and the audit log record. Too few and every caller looks
# like the proxy; too many and a caller can write their own X-Forwarded-For and be believed.
TRUST_PROXY_HOPS=1

# The date a restore was last rehearsed (npm run backup:verify), as YYYY-MM-DD. Read only by
# `npm run preflight`, which fails it once it is more than 90 days old.
BACKUP_VERIFIED_AT=

# --- SMS gateway (X Technologies) ---
# Leave the token empty and the SMS channel switches itself off, exactly as it behaved before a
# vendor existed. Nothing else needs changing to run without SMS.
SMS_API_URL="https://sms.xtechnologies.com.ss/api/http/sms/send"
SMS_API_TOKEN=""
# What appears on the recipient's handset. The gateway caps an alphanumeric sender at 11
# characters, and in most countries it has to be registered with the operators before it will
# deliver.
SMS_SENDER_ID="NCA"
